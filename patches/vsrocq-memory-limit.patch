+(*   See LICENSE file.                                                    *)
+(*                                                                        *)
+(**************************************************************************)
+
+open Dm
+
+(* Regression test: a job that allocates past [memory_limit] must be aborted
+   with an error rather than growing without bound (see vsrocq.memory.limit).
+   The limit is expressed in kiB by [ProverThread.set_options]. *)
+
+let baseline_kib () =
+  let { Gc.heap_words; _ } = Gc.stat () in
+  Sys.word_size * heap_words / 1024
+
+let%test_unit "proverThread: memory limit aborts a job" =
+  let margin_kib = 100 * 1024 (* 100 MiB *) in
+  ProverThread.set_options ~preempt:false ~memory_limit:(baseline_kib () + margin_kib);
+  let outcome =
+    ProverThread.run ~doc_id:0 ~name:"memory-limit-test" (fun () ->
+        (* ~200 MiB on 64-bit, comfortably above the margin. *)
+        let big = Array.make 25_000_000 0 in
+        Array.length big)
+  in
+  (* Restore the default (disabled) limit so other tests are unaffected. *)
+  ProverThread.set_options ~preempt:false ~memory_limit:(-1);
+  match outcome with
+  | Ok _ -> failwith "expected the job to be aborted by the memory limit"
+  | Error _ -> ()
diff --git a/language-server/vsrocqtop/lspManager.ml b/language-server/vsrocqtop/lspManager.ml
index ffc02dc..3246e3e 100644
--- a/language-server/vsrocqtop/lspManager.ml
+++ b/language-server/vsrocqtop/lspManager.ml
@@ -131,6 +131,12 @@ let do_configuration settings =
   full_diagnostics := settings.diagnostics.full;
   full_messages := settings.goals.messages.full;
   max_memory_usage := settings.memory.limit * 1000000000;
+  (* [Memory.limit] is expressed in GB; Memprof_limits expects kiB.  A
+     non-positive value disables the limit. *)
+  let memory_limit_kib =
+    if settings.memory.limit <= 0 then -1
+    else settings.memory.limit * 1000000000 / 1024
+  in
   Dm.CheckingManager.set_options {
     Dm.CheckingManager.check_mode = settings.proof.mode;
     block_on_first_error = settings.proof.block;
@@ -138,6 +144,7 @@ let do_configuration settings =
     pp_mode = Option.default Settings.Goals.PrettyPrint.Pp settings.goals.ppmode;
     diff_mode = Settings.Goals.Diff.Mode.Off;
     preempt = settings.interrupt.preempt;
+    memory_limit = memory_limit_kib;
     (* Diff mode is broken, cfr #1163 #1164 *)
     (* diff_mode := settings.goals.diff.mode; *)
   }
